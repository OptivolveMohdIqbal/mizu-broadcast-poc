{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-npm-dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*"
        },
        "pattern": {
          "regexp": "^.*$"
        }
      }
    }
  ]
}
