# Start with mock mode. Change to false after adding your licensed/demo webphone files.
VITE_MIZU_MOCK=true

# These are read only by the browser. Do NOT put production secrets here.
VITE_MIZU_SERVER=wss://your-mizutech-server.example.com
VITE_MIZU_USERNAME=psim-broadcast
VITE_MIZU_PASSWORD=change-me

# Optional: override where webphone_api.js is served from.
VITE_MIZU_SCRIPT=/mizu/webphone_api.js
